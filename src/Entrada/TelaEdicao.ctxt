comment8.text=\r\n\ Retorna\ o\ bot\u00E3o\ de\ confirma\u00E7\u00E3o\ da\ edi\u00E7\u00E3o.\r\n\r\n\ @return\ objeto\ JButton\ Confirmar.\r\n
